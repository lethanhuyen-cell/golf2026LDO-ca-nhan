#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
LỆNH TẠO GIẢI GOLF / THỂ THAO SIÊU NHANH
Chỉ cần gõ:
   ./taogiai "Tên Giải" "Ngày tổ chức" "Tên Sân"
Hoặc:
   ./taogiai
"""

import os
import sys
import json
import shutil
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent
TEMPLATE_DIR = ROOT_DIR / "mau-golf" if (ROOT_DIR / "mau-golf").exists() else ROOT_DIR / "_bo_template_chuan_sports_luxe"

def print_banner():
    print("=" * 65)
    print(" ⛳ CÔNG CỤ TẠO GIẢI GOLF / THỂ THAO SIÊU NHANH (MẪU GOLF) ⛳")
    print("=" * 65)

def slugify(text):
    text = text.lower().strip()
    replacements = {
        'à': 'a', 'á': 'a', 'ả': 'a', 'ã': 'a', 'ạ': 'a',
        'ă': 'a', 'ằ': 'a', 'ắ': 'a', 'ẳ': 'a', 'ẵ': 'a', 'ặ': 'a',
        'â': 'a', 'ầ': 'a', 'ấ': 'a', 'ẩ': 'a', 'ẫ': 'a', 'ậ': 'a',
        'đ': 'd',
        'è': 'e', 'é': 'e', 'ẻ': 'e', 'ẽ': 'e', 'ẹ': 'e',
        'ê': 'e', 'ề': 'e', 'ế': 'e', 'ể': 'e', 'ễ': 'e', 'ệ': 'e',
        'ì': 'i', 'í': 'i', 'ỉ': 'i', 'ĩ': 'i', 'ị': 'i',
        'ò': 'o', 'ó': 'o', 'ỏ': 'o', 'õ': 'o', 'ọ': 'o',
        'ô': 'o', 'ồ': 'o', 'ố': 'o', 'ổ': 'o', 'ỗ': 'o', 'ộ': 'o',
        'ơ': 'o', 'ờ': 'o', 'ớ': 'o', 'ở': 'o', 'ỡ': 'o', 'ợ': 'o',
        'ù': 'u', 'ú': 'u', 'ủ': 'u', 'ũ': 'u', 'ụ': 'u',
        'ư': 'u', 'ừ': 'u', 'ứ': 'u', 'ử': 'u', 'ữ': 'u', 'ự': 'u',
        'ỳ': 'y', 'ý': 'y', 'ỷ': 'y', 'ỹ': 'y', 'ỵ': 'y',
        ' ': '_', '-': '_'
    }
    res = []
    for c in text:
        if c in replacements:
            res.append(replacements[c])
        elif c.isalnum() or c == '_':
            res.append(c)
    return "".join(res)

def main():
    print_banner()

    # Default template variables
    sample_cfg_path = TEMPLATE_DIR / "variables_sample.json"
    with open(sample_cfg_path, 'r', encoding='utf-8') as f:
        vars_map = json.load(f)

    # Check CLI arguments: ./taogiai "Tên Giải" "Ngày" "Sân"
    if len(sys.argv) >= 2:
        event_name = sys.argv[1].strip()
        event_date = sys.argv[2].strip() if len(sys.argv) >= 3 else "Chủ Nhật, ngày 15.11.2026"
        venue_name = sys.argv[3].strip() if len(sys.argv) >= 4 else "Sân Golf Tân Sơn Nhất"
    else:
        # Check if root cauhinh.json exists
        root_cauhinh = ROOT_DIR / "cauhinh.json"
        if root_cauhinh.exists():
            print(f"[*] Tìm thấy file '{root_cauhinh.name}'. Đang đọc cấu hình...")
            with open(root_cauhinh, 'r', encoding='utf-8') as f:
                custom_vars = json.load(f)
            vars_map.update(custom_vars)
            event_name = vars_map.get("TOURNAMENT_NAME_TITLE", "Giải Golf Mới")
            event_date = vars_map.get("TOURNAMENT_DATE_FULL", "15.11.2026")
            venue_name = vars_map.get("VENUE_NAME", "Sân Golf")
        else:
            print("\n💡 Bạn có thể nhập nhanh thông tin giải mới (nhấn Enter để dùng mặc định):")
            input_name = input("1. Tên giải đấu (vd: Giải Golf Mùa Xuân 2027): ").strip()
            event_name = input_name if input_name else "Giải Golf Báo Lao Động Mùa Xuân 2027"

            input_date = input("2. Ngày tổ chức (vd: Chủ Nhật, 28.03.2027): ").strip()
            event_date = input_date if input_date else "Chủ Nhật, ngày 28.03.2027"

            input_venue = input("3. Sân thi đấu (vd: Sân Golf Tân Sơn Nhất): ").strip()
            venue_name = input_venue if input_venue else "Sân Golf Tân Sơn Nhất"

    # Update map
    vars_map["TOURNAMENT_NAME_UPPER"] = event_name.upper()
    vars_map["TOURNAMENT_NAME_TITLE"] = event_name
    vars_map["TOURNAMENT_SHORT_NAME"] = event_name
    vars_map["TOURNAMENT_DATE_FULL"] = event_date
    vars_map["TOURNAMENT_DATE_WITH_DAY"] = event_date
    vars_map["VENUE_NAME"] = venue_name
    vars_map["VENUE_FULL_NAME"] = venue_name

    # Target folder
    folder_name = "Giai_" + slugify(event_name)
    out_dir = ROOT_DIR / folder_name
    out_dir.mkdir(parents=True, exist_ok=True)

    print(f"\n🚀 Đang tạo giải đấu mới vào thư mục: {folder_name}/")

    # Run build
    build_script = TEMPLATE_DIR / "build_event.py"
    temp_cfg = out_dir / "_temp_config.json"
    with open(temp_cfg, 'w', encoding='utf-8') as f:
        json.dump(vars_map, f, ensure_ascii=False, indent=2)

    cmd = f'python3 "{build_script}" --config "{temp_cfg}" --out "{out_dir}"'
    ret = os.system(cmd)
    if temp_cfg.exists():
        temp_cfg.unlink()

    if ret == 0:
        print("\n" + "=" * 65)
        print("🎉 HOÀN THÀNH XUẤT SẮC!")
        print(f"👉 Thư mục dự án: {out_dir}")
        print("👉 Các file đã tạo sẵn: index.html, dossier.html (10 trang), dossier_ca_nhan.html (3 trang)")
        print(f"👉 Để xuất in PDF ngay: cd '{folder_name}' && python3 render_pdf.py")
        print("=" * 65)
    else:
        print("[!] Đã xảy ra lỗi trong quá trình tạo giải.")

if __name__ == '__main__':
    main()
